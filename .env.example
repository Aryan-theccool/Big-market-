# Inkspace Environment Variables

# ─── Deployment Targets ─────────────────────────────────────────
# For production, update these to your deployed URLs

# Frontend (Vercel)
NEXT_PUBLIC_APP_URL=https://inkspace.vercel.app

# Backend (Render)
NEXT_PUBLIC_API_URL=https://inkspace-backend.onrender.com

# ─── Real-time Collaboration ────────────────────────────────────
# Y.js WebSocket provider endpoint
NEXT_PUBLIC_WEBSOCKET_URL=wss://inkspace-backend.onrender.com

# ─── Security ────────────────────────────────────────────────────
# Add your security secrets here
NODE_ENV=production

# ─── Optional: Analytics ────────────────────────────────────────
# Add any analytics keys or tracking IDs
# NEXT_PUBLIC_ANALYTICS_KEY=your_key_here
