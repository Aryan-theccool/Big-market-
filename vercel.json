{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["iad"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
